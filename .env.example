# Origin of the ClientTempo application. No trailing slash.
# Defaults to https://app.clienttempo.com when unset.
# Set this only to point a preview or staging build at a different app.
NEXT_PUBLIC_APP_ORIGIN=

# Optional full-URL overrides.
# NEXT_PUBLIC_SIGN_IN_URL=
# NEXT_PUBLIC_SIGN_UP_URL=
# NEXT_PUBLIC_SUPPORT_URL=
# NEXT_PUBLIC_PRIVACY_URL=
# NEXT_PUBLIC_TERMS_URL=
